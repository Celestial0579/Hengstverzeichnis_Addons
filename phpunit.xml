<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnAllIssues="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <!-- displayDetailsOnAllIssues nennt Fundstelle und Auslöser jeder Deprecation,
         statt sie hinter "OK, but there were issues!" zu verstecken.
         failOnDeprecation/-Notice/-Warning (analog Hengstverzeichnis_Framework #147):
         nachgerüstet, seit composer.lock auf einem Framework-Stand liegt, der die
         frühere curl_close()-Deprecation in tests/Support/HttpClient.php nicht mehr
         auslöst (Lock-Bump auf 6464a63 in PR #42) - ein künftiger Fund macht den
         Lauf damit hart rot statt still "OK, but there were issues!". -->
    <testsuites>
        <!-- Strukturprüfung jedes Plugins unter plugins/ (Manifest, Namensschema,
             PHP-Syntax) - läuft ohne Datenbank/Framework-Server, automatisch für
             jedes neu hinzugefügte Plugin, ohne dass diese Datei angepasst werden muss. -->
        <testsuite name="Manifest">
            <directory>tests/Manifest</directory>
        </testsuite>
        <!-- Rechenkerne einzelner Plugins, die als reine Funktionen prüfbar sind -
             ohne Datenbank, ohne laufende Framework-Instanz, in Millisekunden.
             Gedacht für Fälle, die über HTTP nur mit unverhältnismäßigem Aufwand
             abzubilden wären (z. B. viele Verwandtschaftsgrade beim COI). Das
             Zusammenspiel eines Plugins mit dem Kern gehört weiterhin nach
             tests/Functional. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Ein Test pro Plugin, der es tatsächlich in eine laufende
             Hengstverzeichnis_Framework-Instanz aktiviert und per HTTP durchspielt
             (siehe tests/bootstrap.php für die Kopie nach vendor/.../plugins). -->
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
</phpunit>
