{
    "slug": "kontaktanfrage",
    "name": "Kontaktanfrage",
    "version": "1.1.4",
    "core_compatibility": ">=0.8.0-beta.1",
    "core_supported_max": "0.9",
    "description": "Kontaktformular auf den Kontaktseiten mit E-Mail, Name und fester Gründe-Auswahl - ohne dass die Adresse des Empfängers öffentlich wird. Anfragen gehen an eine Team-Adresse, werden gespeichert und lassen sich im Backend weiterleiten; je Kontakt abschaltbar (Opt-out).",
    "author": "Hengstverzeichnis_Addons",
    "hooks": [
        "contact.detail_sections",
        "contact.edit_sections",
        "admin.dashboard_tiles"
    ],
    "permissions": [
        "kontaktanfrage.manage"
    ],
    "owns": {
        "tables": [
            "plugin_kontaktanfrage_requests",
            "plugin_kontaktanfrage_optout",
            "plugin_kontaktanfrage_config"
        ],
        "directories": [],
        "settings": []
    },
    "weiche_verweise": {
        "plugin_kontaktanfrage_requests": [
            {
                "ziel": "contacts",
                "spalte": "contact_id",
                "trennen": "null_wert"
            }
        ],
        "plugin_kontaktanfrage_optout": [
            {
                "ziel": "contacts",
                "spalte": "contact_id",
                "trennen": "loeschen"
            }
        ]
    },
    "entry": "Plugin.php"
}
